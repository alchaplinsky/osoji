# Copy to .env and fill in for a local signed release build (scripts/release-local.sh).
# See docs/RELEASING.md. `.env` is gitignored.

# --- macOS code signing + notarization ---
# From `security find-identity -v -p codesigning`, e.g.
# "Developer ID Application: Your Name (TEAMID)".
APPLE_SIGNING_IDENTITY=""
# Apple ID email, an app-specific password (not the account password), and the Team ID.
APPLE_ID=""
APPLE_PASSWORD=""
APPLE_TEAM_ID=""

# --- Updater artifact signing (Tauri minisign keypair) ---
# Contents of the private key generated via `bun run tauri signer generate`.
# Stored locally outside the repo (e.g. ~/.tauri/osoji.key); load it inline:
TAURI_SIGNING_PRIVATE_KEY="$(cat ~/.tauri/osoji.key)"
# Password for the key above. Empty if the key was generated without one.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
