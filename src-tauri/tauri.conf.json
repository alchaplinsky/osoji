{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osoji",
  "version": "0.1.0",
  "identifier": "dev.osoji.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Osoji",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false,
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#0C0C0E"
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QzE0QkEyMjk4N0JDMDUKUldRRnZJY3Bva3ZCVnR4UnZld1oxbVU1YVhsUGtycVZTMW1YZENmMXIwbWU4aUR4UUV6b2srM20K",
      "endpoints": ["https://github.com/alchaplinsky/osoji/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
